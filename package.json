{
  "name": "@ruxt/core",
  "version": "0.1.1",
  "type": "module",
  "description": "Framework-free domain, CQRS, saga, and application contracts shared by Ruxt services.",
  "sideEffects": false,
  "files": [
    "domain",
    "handlers",
    "repos",
    "shared",
    "cqrs.ts",
    "saga.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./cqrs": "./cqrs.ts",
    "./saga": "./saga.ts",
    "./domain/*": "./domain/*/index.ts",
    "./domain/cv/*": "./domain/cv/*.ts",
    "./handlers/*": "./handlers/*.ts",
    "./repos/*": "./repos/*.ts",
    "./shared": "./shared/index.ts",
    "./shared/*": "./shared/*.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "node scripts/lint-architecture.mjs"
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  }
}
