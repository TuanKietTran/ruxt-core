{
  "name": "@ruxt/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-free domain, CQRS, analytics, and application contracts shared by Ruxt services.",
  "sideEffects": false,
  "files": [
    "analytics",
    "domain",
    "handlers",
    "ports",
    "repos",
    "services",
    "shared",
    "cqrs.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./cqrs": "./cqrs.ts",
    "./analytics/*": "./analytics/*.ts",
    "./domain/*": "./domain/*/index.ts",
    "./domain/cv/*": "./domain/cv/*.ts",
    "./handlers/*": "./handlers/*.ts",
    "./ports/*": "./ports/*.ts",
    "./repos/*": "./repos/*.ts",
    "./services/*": "./services/*.ts",
    "./shared": "./shared/index.ts",
    "./shared/*": "./shared/*.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
